# Active Support

###
# Isolate Rails internal state by fiber rather than thread.
#
# This prevents concurrent fibers on the same thread from sharing
# execution-local state, including Active Record connection leases. Code that
# intentionally shares Rails execution-local state between fibers may need to
# propagate that state explicitly.
#++
# Rails.application.config.active_support.isolation_level = :fiber
